# --- Supabase (igual que siempre) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# --- Carga de gastos desde afuera (/api/ingesta y /api/whatsapp) ---
# Service role de Supabase (Settings > API). NUNCA en el cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# Secreto inventado por vos para autorizar a /api/ingesta (Forms, atajos).
INGESTA_TOKEN=un-secreto-largo-inventado

# --- Notificaciones push (avisos de gastos, vencimientos y cierre) ---
# Generá el par con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto requerido por el estándar VAPID.
VAPID_SUBJECT=mailto:matiarona@gmail.com
# Secreto para el cron diario de recordatorios (Vercel lo manda solo).
CRON_SECRET=otro-secreto-largo

# --- WhatsApp (Meta Cloud API) — opcional, solo si usan el bot ---
# Token de verificación del webhook (lo inventás vos y lo repetís en Meta).
WHATSAPP_VERIFY_TOKEN=otro-secreto-inventado
# Token de acceso permanente de la app de Meta (para responder mensajes).
WHATSAPP_TOKEN=
# ID del número de teléfono del bot (WhatsApp > API Setup).
WHATSAPP_PHONE_ID=
# App secret de la app de Meta (valida que los webhooks vengan de Meta).
WHATSAPP_APP_SECRET=
